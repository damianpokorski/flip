{
	"name": "flip",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.0"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "vp run -r --parallel dev",
		"dev:server": "vp run --filter server dev",
		"dev:web": "vp run --filter web dev",
		"build": "vp run -r build",
		"check-types": "vp run -r check-types",
		"test": "vp run -r test",
		"test:coverage": "vp run -r test:coverage",
		"test:e2e": "vp run --filter web test:e2e",
		"test:e2e:install": "vp run --filter web test:e2e:install",
		"check": "biome check --write .",
		"lint": "vp lint",
		"format": "vp fmt",
		"staged": "vp staged",
		"hooks:setup": "vp config",
		"bootstrap": "vp run --filter @flip/bootstrap start",
		"dev:bootstrap": "bun run bootstrap",
		"data:reset": "rm -rf data && bun run bootstrap",
		"docker:stop": "(docker stop flip 2&> /dev/null || echo 'No containers needing stopping') && (docker rm -f flip 2&> /dev/null || echo 'No old containers to remove') ",
		"docker": "docker buildx build -t flip . && bun run docker:stop && docker run -it --name flip -p 3000:3000 -v flip-data:/data flip"
	},
	"dependencies": {
		"@flip/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@flip/config": "workspace:*",
		"@types/bun": "catalog:",
		"rolldown": "1.2.6",
		"typescript": "catalog:",
		"vite-plus": "0.3.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
	},
	"packageManager": "bun@1.3.14"
}
