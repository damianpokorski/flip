{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"test": "bun test ./src --isolate",
		"test:coverage": "bun test ./src --coverage --isolate"
	},
	"dependencies": {
		"@elysia/openapi": "^1.4.16",
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/static": "^1.4.10",
		"@flip/env": "workspace:*",
		"@flip/store": "workspace:*",
		"@sinclair/typebox": "^0.34.52",
		"dotenv": "catalog:",
		"elysia": "^1.4.29",
		"uuid": "^14.0.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@flip/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	}
}
